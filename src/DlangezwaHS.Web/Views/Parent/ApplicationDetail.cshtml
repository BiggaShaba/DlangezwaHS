@* ApplicationDetail.cshtml – Parent *@
@model ApplicationDetailViewModel
@{
    ViewData["Title"] = $"Application #{Model.Application.Id}";
    var app     = Model.Application;
    var learner = app.Learner!;
}

<div class="page-header k-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active">Application #@app.Id</li>
        </ol>
    </nav>
    <h2><i class="bi bi-file-earmark-person me-2"></i>Application #@app.Id</h2>
    <p>@learner.FullName — @app.SubmittedAt.ToString("dd MMM yyyy")</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <!-- Status -->
        <div class="alert @(app.Status == ApplicationStatus.Pending ? "alert-warning" : app.Status == ApplicationStatus.Approved || app.Status == ApplicationStatus.Enrolled ? "alert-success" : "alert-danger") d-flex align-items-center gap-3 mb-4">
            <i class="bi @(app.Status == ApplicationStatus.Pending ? "bi-hourglass-split" : app.Status == ApplicationStatus.Approved || app.Status == ApplicationStatus.Enrolled ? "bi-check-circle-fill" : "bi-x-circle-fill") fs-3"></i>
            <div>
                <div class="fw-bold fs-5">@app.Status</div>
                @if (app.Status == ApplicationStatus.Pending)
                { <div class="small opacity-80">Your application is under review. We will notify you by email.</div> }
                @if (app.Status == ApplicationStatus.Approved || app.Status == ApplicationStatus.Enrolled)
                { <div class="small opacity-80">Congratulations! Your application was approved. The school will be in touch regarding enrolment.</div> }
                @if (app.Status == ApplicationStatus.Rejected)
                {
                    <div class="small"><strong>Reason:</strong> @(app.RejectionReason ?? "No reason provided.")</div>
                    <div class="small mt-1">Please contact the admissions office if you have questions.</div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h5>Learner Details</h5></div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var (lbl, val) in new[]{
                        ("Name",         learner.FullName),
                        ("ID Number",    learner.LearnerIdNumber),
                        ("Date of Birth",learner.DateOfBirth.ToString("dd MMM yyyy")),
                        ("Gender",       learner.Gender)
                    })
                    {
                        <div class="col-6">
                            <div class="small text-muted">@lbl</div>
                            <div class="fw-semibold">@val</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="k-btn k-btn-ghost"><i class="bi bi-arrow-left me-1"></i> Back</a>
            @if (app.Status == ApplicationStatus.Enrolled)
            {
                <a asp-action="Pay" asp-route-learnerId="@app.LearnerId" asp-route-type="Registration"
                   class="k-btn k-btn-primary">
                    <i class="bi bi-credit-card me-1"></i> Pay Registration Fee
                </a>
            }
        </div>
    </div>
</div>
