@using Microsoft.AspNetCore.Mvc.Rendering
@model AssignCoachViewModel
@{ ViewData["Title"] = "Assign Coaches"; }

<div class="row justify-content-center">
<div class="col-md-7">
<div class="page-header"><h2><i class="bi bi-person-badge me-2"></i>Assign Coaches / Mentors</h2></div>
<div class="card">
    <div class="card-body p-4">
        <form asp-action="AssignCoach" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

            <div class="mb-3">
                <label asp-for="ActivityId" class="form-label">Activity <span class="text-danger">*</span></label>
                <select asp-for="ActivityId" asp-items="@(new SelectList(Model.Activities, "Id", "Name"))" class="form-select">
                    <option value="">Select activity…</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="TeacherId" class="form-label">Staff Member <span class="text-danger">*</span></label>
                <select asp-for="TeacherId" asp-items="@(new SelectList(Model.Teachers, "Id", "FullName"))" class="form-select">
                    <option value="">Select staff member…</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label">Role</label>
                <select asp-for="Role" asp-items="Html.GetEnumSelectList<CoachRole>()" class="form-select"></select>
            </div>
            <div class="mb-4">
                <label asp-for="Period" class="form-label">Assignment Period</label>
                <select asp-for="Period" asp-items="Html.GetEnumSelectList<AssignmentPeriod>()" class="form-select"></select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dhs-primary px-4"><i class="bi bi-check me-1"></i>Assign</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
