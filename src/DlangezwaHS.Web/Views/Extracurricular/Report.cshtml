@using Microsoft.AspNetCore.Mvc.Rendering
@model ActivityReportViewModel
@{ ViewData["Title"] = "Activity Report"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2><i class="bi bi-bar-chart me-2"></i>Activity Report</h2></div>
    <div class="d-flex gap-2">
        <a asp-action="ReportPrint" asp-route-type="@Model.Type" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-gradeLevel="@Model.GradeLevel" asp-route-activityId="@Model.ActivityId" target="_blank" class="btn btn-dhs-secondary">
            <i class="bi bi-printer me-1"></i>Print
        </a>
        <a asp-action="ReportPdf" asp-route-type="@Model.Type" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-gradeLevel="@Model.GradeLevel" asp-route-activityId="@Model.ActivityId" class="btn btn-dhs-secondary">
            <i class="bi bi-file-earmark-pdf me-1"></i>Export PDF
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small">Type</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var t in Enum.GetValues<ActivityType>())
                    { <option value="@t" selected="@(Model.Type == t)">@t</option> }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small">Activity</label>
                <select name="activityId" class="form-select form-select-sm">
                    <option value="">All Activities</option>
                    @foreach (var a in Model.Activities)
                    { <option value="@a.Id" selected="@(Model.ActivityId == a.Id)">@a.Name</option> }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small">From</label>
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label small">To</label>
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-dhs-primary btn-sm">Generate Report</button></div>
        </form>
    </div>
</div>

<style>
    .dhs-chart-card {
        border-top: 3px solid var(--dhs-accent, #2a78d6);
        transition: box-shadow .2s ease, transform .2s ease;
    }
    .dhs-chart-card:hover {
        box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.08);
        transform: translateY(-1px);
    }
    .dhs-chart-card .card-header i { color: var(--dhs-accent, #2a78d6); }

    .dhs-stat-tile { transition: box-shadow .2s ease, transform .2s ease; }
    .dhs-stat-tile:hover { box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.08); transform: translateY(-1px); }

    .dhs-bar-chart .bar-fill {
        transform-box: fill-box;
        transform-origin: left center;
        animation: dhs-bar-grow .75s cubic-bezier(.16,.84,.44,1) both;
        animation-delay: calc(var(--i, 0) * 80ms);
    }
    .dhs-bar-chart .bar-label,
    .dhs-bar-chart .bar-icon {
        opacity: 0;
        animation: dhs-label-fade .4s ease-out forwards;
        animation-delay: calc(var(--i, 0) * 80ms + .3s);
    }
    @@keyframes dhs-bar-grow {
        0%   { transform: translateY(8px) scaleX(0); filter: drop-shadow(0 0 0 transparent); }
        55%  { filter: drop-shadow(0 0 7px var(--glow, transparent)); }
        100% { transform: translateY(0) scaleX(1); filter: drop-shadow(0 0 0 transparent); }
    }
    @@keyframes dhs-label-fade {
        from { opacity: 0; transform: translateY(2px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .dhs-bar-chart .bar-fill, .dhs-bar-chart .bar-label, .dhs-bar-chart .bar-icon { animation: none; opacity: 1; }
    }
</style>

@if (Model.Report is not null)
{
    var r = Model.Report;
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card dhs-stat-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-collection-fill fs-3" style="color:#2a78d6"></i>
                    <div><div class="text-muted small">Activities</div><div class="fs-4 fw-bold dhs-count" data-target="@r.TotalActivities" data-decimals="0">0</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dhs-stat-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-people-fill fs-3" style="color:#eb6834"></i>
                    <div><div class="text-muted small">Participants</div><div class="fs-4 fw-bold dhs-count" data-target="@r.TotalParticipants" data-decimals="0">0</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dhs-stat-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-check2-circle fs-3" style="color:#1baf7a"></i>
                    <div><div class="text-muted small">Avg Attendance</div><div class="fs-4 fw-bold dhs-count" data-target="@r.AverageAttendancePct.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1" data-suffix="%">0%</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card dhs-stat-tile">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-trophy-fill fs-3" style="color:#eda100"></i>
                    <div><div class="text-muted small">Achievements</div><div class="fs-4 fw-bold dhs-count" data-target="@r.TotalAchievements" data-decimals="0">0</div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card dhs-chart-card h-100" style="--dhs-accent:#2a78d6">
                <div class="card-header"><i class="bi bi-collection-fill me-2"></i><strong>Activities by Type</strong></div>
                <div class="card-body">@Html.Raw(BarChartSvg(r.ActivitiesByType.Select(x => (x.TypeName, (double)x.Count)), "#2a78d6", "bi-collection-fill"))</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card dhs-chart-card h-100" style="--dhs-accent:#eb6834">
                <div class="card-header"><i class="bi bi-people-fill me-2"></i><strong>Participants by Activity</strong></div>
                <div class="card-body">@Html.Raw(BarChartSvg(r.ParticipantsByActivity.Select(x => (x.ActivityName, (double)x.Participants)), "#eb6834", "bi-people-fill"))</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card dhs-chart-card h-100" style="--dhs-accent:#1baf7a">
                <div class="card-header"><i class="bi bi-check2-circle me-2"></i><strong>Avg Attendance by Activity</strong></div>
                <div class="card-body">@Html.Raw(BarChartSvg(r.AttendanceByActivity.Select(x => (x.ActivityName, x.AttendancePct)), "#1baf7a", "bi-check2-circle", "%"))</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card dhs-chart-card h-100" style="--dhs-accent:#eda100">
                <div class="card-header"><i class="bi bi-trophy-fill me-2"></i><strong>Achievements by Activity</strong></div>
                <div class="card-body">@Html.Raw(BarChartSvg(r.AchievementsByActivity.Select(x => (x.ActivityName, (double)x.Count)), "#eda100", "bi-trophy-fill"))</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Attendance by Activity</strong></div>
                <div class="card-body p-0">
                    <table class="table table-dhs mb-0">
                        <thead><tr><th>Activity</th><th>Sessions</th><th>Attendance %</th></tr></thead>
                        <tbody>
                        @foreach (var row in r.AttendanceByActivity)
                        {
                            <tr><td>@row.ActivityName</td><td>@row.SessionCount</td><td>@row.AttendancePct.ToString("N1")%</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Top Achievers</strong></div>
                <div class="card-body p-0">
                    <table class="table table-dhs mb-0">
                        <thead><tr><th>Learner</th><th>Achievements</th></tr></thead>
                        <tbody>
                        @foreach (var row in r.TopAchievers)
                        {
                            <tr><td>@row.LearnerName</td><td>@row.Count</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Coach Summary</strong></div>
                <div class="card-body p-0">
                    <table class="table table-dhs mb-0">
                        <thead><tr><th>Coach</th><th>Activities</th></tr></thead>
                        <tbody>
                        @foreach (var row in r.CoachSummary)
                        {
                            <tr><td>@row.CoachName</td><td>@string.Join(", ", row.Activities)</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Participation Summary</strong></div>
                <div class="card-body p-0" style="max-height:300px;overflow-y:auto;">
                    <table class="table table-dhs mb-0">
                        <thead><tr><th>Learner</th><th>Activities</th></tr></thead>
                        <tbody>
                        @foreach (var row in r.ParticipationSummary)
                        {
                            <tr><td>@row.LearnerName</td><td>@row.ActivityCount</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@functions {
    string BarChartSvg(IEnumerable<(string Label, double Value)> data, string colorHex, string iconClass, string unit = "")
    {
        var items = data.Where(d => d.Value > 0).OrderByDescending(d => d.Value).Take(8).ToList();
        if (items.Count == 0) return "<p class='text-muted small mb-0'>No data for the selected filters.</p>";

        const int rowHeight = 34, chartWidth = 360, iconSize = 14, labelX = iconSize + 3;
        var max = items.Max(d => d.Value);
        var height = items.Count * rowHeight + 6;
        var glow = colorHex + "b3";
        var svg = new System.Text.StringBuilder();
        svg.Append(System.Globalization.CultureInfo.InvariantCulture, $"<svg class='dhs-bar-chart' viewBox='0 0 {chartWidth} {height}' width='100%' height='{height}' role='img' aria-label='Bar chart' xmlns='http://www.w3.org/2000/svg'>");

        for (var i = 0; i < items.Count; i++)
        {
            var (label, value) = items[i];
            var y = i * rowHeight;
            var barWidth = Math.Max((value / max) * (chartWidth - 60), 4);
            var safeLabel = System.Net.WebUtility.HtmlEncode(label);
            var valueText = unit == "%" ? value.ToString("0.#") + unit : value.ToString("0");

            svg.Append(System.Globalization.CultureInfo.InvariantCulture, $"<foreignObject class='bar-icon' style='--i:{i}' x='0' y='{y}' width='{iconSize}' height='{iconSize}'><div xmlns='http://www.w3.org/1999/xhtml' style='font-size:10px;line-height:{iconSize}px;color:{colorHex}'><i class='bi {iconClass}'></i></div></foreignObject>");
            svg.Append(System.Globalization.CultureInfo.InvariantCulture, $"<text class='bar-label' style='--i:{i}' x='{labelX}' y='{y + 11}' font-size='11' fill='#52514e' font-family='system-ui,-apple-system,\"Segoe UI\",sans-serif'>{safeLabel}</text>");
            svg.Append(System.Globalization.CultureInfo.InvariantCulture, $"<rect class='bar-fill' style='--i:{i};--glow:{glow}' x='0' y='{y + 16}' width='{barWidth:0.##}' height='10' rx='4' fill='{colorHex}'><title>{safeLabel}: {valueText}</title></rect>");
            svg.Append(System.Globalization.CultureInfo.InvariantCulture, $"<text class='bar-label' style='--i:{i}' x='{barWidth + 6:0.##}' y='{y + 25}' font-size='10' fill='#0b0b0b' font-family='system-ui,-apple-system,\"Segoe UI\",sans-serif'>{valueText}</text>");
        }

        svg.Append("</svg>");
        return svg.ToString();
    }
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.dhs-count').forEach(function (el) {
        var target = parseFloat(el.getAttribute('data-target')) || 0;
        var decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
        var suffix = el.getAttribute('data-suffix') || '';
        var duration = 900;
        var start = null;

        function step(ts) {
            if (!start) start = ts;
            var progress = Math.min((ts - start) / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = (target * eased).toFixed(decimals) + suffix;
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = target.toFixed(decimals) + suffix;
        }
        requestAnimationFrame(step);
    });
});
</script>
}
