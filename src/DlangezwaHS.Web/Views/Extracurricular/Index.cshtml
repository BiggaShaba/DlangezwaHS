@model ExtracurricularDashboardViewModel
@{ ViewData["Title"] = "Extracurricular"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2><i class="bi bi-trophy me-2"></i>Extracurricular Activities</h2></div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ActivityCreate" class="btn btn-dhs-primary"><i class="bi bi-plus-circle me-1"></i>Schedule Activity</a>
            <a asp-action="AssignCoach" class="btn btn-dhs-secondary"><i class="bi bi-person-badge me-1"></i>Assign Coaches</a>
            <a asp-action="Report" class="btn btn-dhs-secondary"><i class="bi bi-bar-chart me-1"></i>Activity Report</a>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4"><div class="card"><div class="card-body"><div class="text-muted small">Activities</div><div class="fs-3 fw-bold">@Model.TotalActivities</div></div></div></div>
    <div class="col-6 col-md-4"><div class="card"><div class="card-body"><div class="text-muted small">Registrations</div><div class="fs-3 fw-bold">@Model.TotalRegistrations</div></div></div></div>
    <div class="col-6 col-md-4"><div class="card"><div class="card-body"><div class="text-muted small">Achievements</div><div class="fs-3 fw-bold">@Model.TotalAchievements</div></div></div></div>
</div>

@if (Model.IsCoach)
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-clipboard2-check me-2"></i>My Coaching Assignments</h5>
            <a asp-action="MyAssignments" class="btn btn-sm btn-outline-secondary">View All</a>
        </div>
        <div class="card-body p-0">
            @if (!Model.MyActivities.Any())
            {
                <div class="p-4 text-center text-muted">No coaching assignments yet.</div>
            }
            else
            {
                <table class="table table-dhs mb-0">
                    <thead><tr><th>Activity</th><th>Type</th><th>Venue</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.MyActivities)
                    {
                        <tr>
                            <td><strong>@a.Name</strong></td>
                            <td>@a.Type</td>
                            <td>@a.Venue</td>
                            <td><a asp-action="AttendanceRegister" asp-route-activityId="@a.Id" class="btn btn-sm btn-dhs-primary">Take Register</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Activities" class="btn btn-outline-secondary"><i class="bi bi-grid me-1"></i>Browse All Activities</a>
</div>
