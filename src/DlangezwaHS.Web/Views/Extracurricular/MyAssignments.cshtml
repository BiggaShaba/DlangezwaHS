@model IList<Activity>
@{ ViewData["Title"] = "My Coaching Assignments"; }

<div class="page-header"><h2><i class="bi bi-clipboard2-check me-2"></i>My Coaching Assignments</h2></div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">You have no coaching assignments yet.</div>
        }
        else
        {
            <table class="table table-dhs mb-0">
                <thead><tr><th>Activity</th><th>Type</th><th>Venue</th><th>Time</th><th></th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><strong>@a.Name</strong></td>
                        <td>@a.Type</td>
                        <td>@a.Venue</td>
                        <td><small>@a.StartTime.ToString(@"hh\:mm")–@a.EndTime.ToString(@"hh\:mm")</small></td>
                        <td class="d-flex gap-1">
                            <a asp-action="AttendanceRegister" asp-route-activityId="@a.Id" class="btn btn-sm btn-dhs-primary">Attendance</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
