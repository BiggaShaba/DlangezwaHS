@model IList<Achievement>
@{ ViewData["Title"] = "Achievements"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2><i class="bi bi-award me-2"></i>Achievements</h2></div>
    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
    {
        <a asp-action="AchievementCreate" class="btn btn-dhs-primary"><i class="bi bi-plus-circle me-1"></i>Add Achievement</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-award fs-1 d-block mb-2" style="color:#97C8E9;"></i>
                No achievements recorded yet.
            </div>
        }
        else
        {
            <table class="table table-dhs mb-0">
                <thead><tr><th>Learner</th><th>Activity</th><th>Type</th><th>Description</th><th>Level</th><th>Date</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.Learner?.FullName</td>
                        <td>@a.Activity?.Name</td>
                        <td><span class="badge badge-approved rounded-pill">@a.Type</span></td>
                        <td>@a.Description</td>
                        <td>@a.Level</td>
                        <td><small>@a.DateAchieved.ToString("dd MMM yyyy")</small></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
