@model AssessmentListViewModel
@{ ViewData["Title"] = "Assessments"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2><i class="bi bi-clipboard2-data me-2"></i>Assessments</h2></div>
    <a asp-action="CreateAssessment" class="btn btn-dhs-secondary">
        <i class="bi bi-plus-circle me-1"></i>New Assessment
    </a>
</div>

<!-- Filter -->
<div class="card mb-4">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small">Term</label>
                <select name="term" class="form-select form-select-sm">
                    <option value="">All Terms</option>
                    @foreach (var t in new[]{"Term 1","Term 2","Term 3","Term 4"})
                    { <option value="@t" selected="@(Model.TermFilter == t)">@t</option> }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small">Type</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var t in new[]{"Test","Assignment","Exam"})
                    { <option value="@t" selected="@(Model.TypeFilter == t)">@t</option> }
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-dhs-primary btn-sm">Filter</button></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Assessments.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-clipboard2 fs-1 d-block mb-2" style="color:#97C8E9;"></i>
                No assessments yet. <a asp-action="CreateAssessment">Create one.</a>
            </div>
        }
        else
        {
            <table class="table table-dhs mb-0">
                <thead><tr><th>Name</th><th>Type</th><th>Class</th><th>Subject</th><th>Date</th><th>Term</th><th>Total</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var a in Model.Assessments)
                {
                    <tr>
                        <td><strong>@a.Name</strong></td>
                        <td><span class="badge rounded-pill @(a.Type == AssessmentType.Exam ? "badge-rejected" : a.Type == AssessmentType.Test ? "badge-pending" : "badge-approved")">@a.Type</span></td>
                        <td>@a.Class?.DisplayName</td>
                        <td>@a.Subject?.Name</td>
                        <td><small>@a.Date.ToString("dd MMM yyyy")</small></td>
                        <td><small>@a.Term</small></td>
                        <td>@a.TotalMarks</td>
                        <td>
                            @if (a.MarksLocked)
                            { <span class="badge badge-enrolled rounded-pill"><i class="bi bi-lock me-1"></i>Locked</span> }
                            else
                            { <span class="badge badge-approved rounded-pill">Open</span> }
                        </td>
                        <td>
                            <a asp-action="CaptureMarks" asp-route-assessmentId="@a.Id"
                               class="btn btn-sm btn-dhs-primary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
