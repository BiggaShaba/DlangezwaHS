@model IList<Learner>
@{
    ViewData["Title"] = "Class Learners";
    var cls = ViewBag.Class as Class;
    var classId = (int)ViewBag.ClassId;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2><i class="bi bi-people me-2"></i>@cls?.DisplayName — Learner List</h2>
        <p>@Model.Count learner(s) enrolled</p>
    </div>
    <a asp-action="RecordAttendance" asp-route-classId="@classId"
       class="btn btn-dhs-primary">
        <i class="bi bi-calendar-check me-1"></i>Record Today's Attendance
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">No learners enrolled in this class yet.</div>
        }
        else
        {
            <table class="table table-dhs mb-0">
                <thead><tr><th>#</th><th>Full Name</th><th>ID Number</th><th>Gender</th></tr></thead>
                <tbody>
                @{ int i = 1; }
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="text-muted small">@(i++)</td>
                        <td><strong>@l.FullName</strong></td>
                        <td><code class="small">@l.LearnerIdNumber</code></td>
                        <td><small>@l.Gender</small></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
