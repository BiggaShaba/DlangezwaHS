@* Error.cshtml *@
@{ ViewData["Title"] = "Error"; }
<div class="row justify-content-center">
    <div class="col-md-6 text-center py-5">
        <span style="font-size:5rem;color:#97C8E9;"><i class="bi bi-exclamation-triangle"></i></span>
        <h2 class="mt-3" style="color:#0B2A4A;">Something went wrong</h2>
        <p class="text-muted">An unexpected error occurred. Please try again or contact support.</p>
        @if (ViewBag.RequestId is string reqId)
        { <p class="text-muted small">Request ID: <code>@reqId</code></p> }
        <a href="/" class="btn btn-dhs-primary mt-3">Go Home</a>
    </div>
</div>
