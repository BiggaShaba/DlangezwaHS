@model IList<MealAttendanceHistoryRow>
@{ ViewData["Title"] = "Meal Attendance"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2><i class="bi bi-clipboard2-data me-2"></i>Meal Attendance</h2><p>Attendance history and reports</p></div>
    <form method="get" class="d-flex gap-2">
        <input type="date" name="date" class="form-control" onchange="this.form.submit()" />
    </form>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">No attendance records for this date.</div>
        }
        else
        {
            <table class="table table-dhs mb-0">
                <thead><tr><th>Learner</th><th>Meal</th><th>Status</th><th>Scanned At</th><th>Override</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><strong>@a.LearnerName</strong></td>
                        <td>@a.MealType — @a.MenuDescription</td>
                        <td>
                            @{
                                var badge = a.Status switch { "Present" => "badge-approved", "Absent" => "badge-rejected", "Unauthorised" => "badge-pending", _ => "badge-pending" };
                            }
                            <span class="badge @badge rounded-pill">@a.Status</span>
                        </td>
                        <td><small>@a.ScannedAt?.ToString("HH:mm")</small></td>
                        <td>@(a.IsManualOverride ? "Yes" : "")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
