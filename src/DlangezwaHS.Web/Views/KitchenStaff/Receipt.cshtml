@model StockReceiptDetailViewModel
@{ ViewData["Title"] = "Receipt"; }

<div class="page-header">
    <nav aria-label="breadcrumb"><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Inventory">Inventory</a></li>
        <li class="breadcrumb-item active">Receipt</li>
    </ol></nav>
    <h2><i class="bi bi-receipt me-2"></i>@Model.SupplierName @if (!string.IsNullOrEmpty(Model.InvoiceNumber)) { <small class="text-muted">#@Model.InvoiceNumber</small> }</h2>
    <p>Dated @Model.ReceiptDate.ToString("dd MMM yyyy") · captured by @Model.CapturedBy on @Model.CapturedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Scanned Document</h5>
                <a href="@Model.DocumentUrl" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-up-right me-1"></i>Open</a>
            </div>
            <div class="card-body text-center">
                @if (Model.DocumentIsPdf)
                {
                    <iframe src="@Model.DocumentUrl" title="Receipt PDF" style="width:100%;height:480px;border:0;"></iframe>
                }
                else
                {
                    <img src="@Model.DocumentUrl" alt="Receipt from @Model.SupplierName" style="max-width:100%;border-radius:8px;" />
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Items Added to Stock</h5></div>
            <div class="card-body p-0">
                <table class="table table-dhs mb-0">
                    <thead><tr><th>Ingredient</th><th>Qty</th><th>Price</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                    @foreach (var l in Model.Lines)
                    {
                        <tr>
                            <td>@l.IngredientName</td>
                            <td>@l.Quantity.ToString("0.##") @l.Unit</td>
                            <td>R@(l.UnitCost.ToString("N2"))</td>
                            <td class="text-end">R@(l.LineTotal.ToString("N2"))</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot><tr><th colspan="3">Total</th><th class="text-end">R@(Model.TotalAmount.ToString("N2"))</th></tr></tfoot>
                </table>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card mt-3"><div class="card-body small"><strong>Notes:</strong> @Model.Notes</div></div>
        }
        <a asp-action="Inventory" class="btn btn-outline-secondary mt-3">Back to Inventory</a>
    </div>
</div>
