@model StockReceiptCreateViewModel
@{
    ViewData["Title"] = "Receive Stock";
    var camel = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    var suppliersJson = System.Text.Json.JsonSerializer.Serialize(Model.Suppliers, camel);
    var ingredientsJson = System.Text.Json.JsonSerializer.Serialize(Model.IngredientOptions, camel);
    var linesJson = System.Text.Json.JsonSerializer.Serialize(Model.Lines.Where(l => l.IngredientId > 0), camel);
}

<style>
    .rs-drop { border: 2px dashed #cbd5e1; border-radius: 18px; padding: 1.3rem; text-align: center; background: #f8fafc; transition: border-color .2s, background .2s; }
    .rs-drop.has-file { border-style: solid; border-color: #10b981; background: #ecfdf5; }
    .rs-drop i.big { font-size: 2rem; color: var(--dhs-blue-dark); }
    #docPreview { max-width: 100%; max-height: 260px; border-radius: 12px; }
    .rs-supplier { border-radius: 16px; background: var(--dhs-light); padding: .8rem 1rem; font-size: .85rem; color: var(--dhs-navy); animation: k-rise .4s var(--ease-spring) both; }
    .rs-line td { transition: background .2s; }
    .rs-line.is-new { animation: k-rise .4s var(--ease-spring) both; }
    .rs-qty { width: 110px; }
    .rs-price { width: 110px; }
    .rs-total { font-size: 1.25rem; font-weight: 700; color: var(--dhs-navy); }
    .rs-remove { width: 32px; height: 32px; border-radius: 10px; border: 0; background: transparent; color: #94a3b8; }
    .rs-remove:hover { background: #fee2e2; color: #dc2626; }
</style>

<div class="page-header k-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2><i class="bi bi-receipt me-2"></i>Receive Stock</h2>
        <p>Choose the supplier, check the quantities delivered, and attach the receipt — stock updates as soon as you save</p>
    </div>
    <a asp-action="Inventory" class="k-btn k-btn-light"><i class="bi bi-box-seam"></i>Inventory</a>
</div>

<form asp-action="ReceiveStock" method="post" enctype="multipart/form-data" id="receiptForm" novalidate>
    @Html.AntiForgeryToken()

    <div class="k-actions">
        <div>
            <div class="k-label mb-0">Receipt total</div>
            <div class="rs-total">R<span id="receiptTotal">0.00</span></div>
        </div>
        <span class="k-sub ms-2" id="lineSummary"></span>
        <div class="ms-auto d-flex gap-2">
            <a asp-action="Inventory" class="k-btn k-btn-ghost">Cancel</a>
            <button type="submit" class="k-btn k-btn-primary" id="saveBtn"><i class="bi bi-check2-circle"></i><span data-label>Save &amp; Add to Stock</span></button>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>
    }
    <div class="alert alert-danger small py-2" id="formError" hidden></div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="k-card k-rise" style="--i:0">
                <div class="k-card-head"><div><h3 class="k-title">1. Supplier</h3><p class="k-sub">Their usual items and prices are filled in for you</p></div></div>
                <label class="k-label" for="supplierSelect">Supplier</label>
                <select id="supplierSelect" class="form-select k-select" aria-describedby="supplierInfo">
                    <option value="">Choose a supplier…</option>
                    @foreach (var s in Model.Suppliers)
                    {
                        <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name (@s.Items.Count items)</option>
                    }
                    <option value="other" selected="@(Model.SupplierId is null && !string.IsNullOrEmpty(Model.SupplierName))">Other supplier…</option>
                </select>
                <input type="hidden" name="SupplierId" id="supplierId" value="@Model.SupplierId" />
                <div id="otherSupplier" class="mt-2" hidden>
                    <input name="SupplierName" id="supplierName" value="@Model.SupplierName" class="form-control k-input" placeholder="Supplier's name" maxlength="150" />
                </div>
                <div id="supplierInfo" class="rs-supplier mt-3" hidden></div>

                <div class="row g-3 mt-1">
                    <div class="col-6">
                        <label class="k-label" asp-for="InvoiceNumber">Invoice no.</label>
                        <input asp-for="InvoiceNumber" class="form-control k-input" />
                    </div>
                    <div class="col-6">
                        <label class="k-label" asp-for="ReceiptDate">Date on receipt</label>
                        <input asp-for="ReceiptDate" type="date" class="form-control k-input" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12">
                        <label class="k-label" asp-for="Notes">Notes <span class="text-lowercase fw-normal">(optional)</span></label>
                        <textarea asp-for="Notes" class="form-control k-input" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <div class="k-card mt-3 k-rise" style="--i:1">
                <div class="k-card-head"><div><h3 class="k-title">2. Receipt or invoice</h3><p class="k-sub">Kept with the stock record so it can be verified later</p></div></div>
                <div class="rs-drop" id="scanDrop">
                    <i class="bi bi-camera big d-block mb-1" id="scanIcon"></i>
                    <div id="scanLabel" class="mb-2"><strong style="color:var(--dhs-navy)">Scan the receipt</strong><br /><span class="k-sub">Photo (JPG/PNG/WEBP) or PDF · max 10 MB</span></div>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <button type="button" class="k-btn k-btn-accent k-btn-sm" id="takePhoto"><i class="bi bi-camera"></i>Take Photo</button>
                        <button type="button" class="k-btn k-btn-ghost k-btn-sm" id="chooseFile"><i class="bi bi-upload"></i>Upload File</button>
                    </div>
                </div>
                <input type="file" name="Document" id="docInput" accept="image/*,application/pdf" class="visually-hidden" tabindex="-1" />
                <div class="text-danger small mt-2" id="docError" hidden>Please scan or upload the receipt first.</div>
                <div class="mt-3 text-center"><img id="docPreview" alt="Receipt preview" hidden /></div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="k-card k-rise" style="--i:2">
                <div class="k-card-head">
                    <div><h3 class="k-title">3. Items received</h3><p class="k-sub">Adjust the quantities to what was delivered · supplier prices are fixed per unit</p></div>
                </div>
                <div class="k-table-wrap">
                    <table class="k-table">
                        <thead><tr><th>Ingredient</th><th>Quantity</th><th class="k-num">Price / unit</th><th class="k-num">Line total</th><th></th></tr></thead>
                        <tbody id="lineRows"></tbody>
                    </table>
                </div>
                <div class="k-empty mt-2" id="noLines"><i class="bi bi-basket"></i><strong>No items yet</strong><p>Choose a supplier to load their items, or add an item below.</p></div>
                <div class="d-flex gap-2 align-items-center mt-3 flex-wrap">
                    <select id="addIngredient" class="form-select k-select" style="max-width:320px" aria-label="Add an item"></select>
                    <button type="button" class="k-btn k-btn-ghost" id="addLine"><i class="bi bi-plus-lg"></i>Add item</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
(function () {
    const suppliers = @Html.Raw(suppliersJson);
    const ingredients = @Html.Raw(ingredientsJson);
    let lines = @Html.Raw(linesJson);         // { ingredientId, quantity, unitCost }
    const rows = document.getElementById('lineRows');
    const select = document.getElementById('supplierSelect');
    const fmt = n => Number(n || 0).toLocaleString('en-ZA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const ingredientById = id => ingredients.find(i => i.id === id);
    const supplier = () => suppliers.find(s => String(s.id) === select.value) || null;
    const supplierItem = id => supplier()?.items.find(i => i.ingredientId === id) || null;

    function render(newId) {
        rows.innerHTML = '';
        lines.forEach((l, idx) => {
            const ing = ingredientById(l.ingredientId), fixed = supplierItem(l.ingredientId);
            if (fixed) l.unitCost = fixed.unitPrice;
            const tr = document.createElement('tr');
            tr.className = 'rs-line' + (l.ingredientId === newId ? ' is-new' : '');
            tr.innerHTML = `
                <td><span class="fw-semibold" style="color:var(--dhs-navy)">${esc(ing ? ing.name : 'Unknown')}</span>
                    <input type="hidden" name="Lines[${idx}].IngredientId" value="${l.ingredientId}"></td>
                <td><div class="input-group input-group-sm rs-qty">
                    <input type="number" step="0.001" min="0" class="form-control" name="Lines[${idx}].Quantity" value="${l.quantity || ''}" aria-label="Quantity of ${esc(ing?.name)}" data-qty>
                    <span class="input-group-text">${esc(ing ? ing.unit : '')}</span></div></td>
                <td class="k-num">${fixed
                    ? `<span class="fw-semibold">R${fmt(fixed.unitPrice)}</span><input type="hidden" name="Lines[${idx}].UnitCost" value="${fixed.unitPrice}">`
                    : `<input type="number" step="0.01" min="0" class="form-control form-control-sm rs-price ms-auto" name="Lines[${idx}].UnitCost" value="${l.unitCost || ''}" placeholder="0.00" aria-label="Price per unit" data-price>`}</td>
                <td class="k-num fw-bold" data-line-total>R${fmt((l.quantity || 0) * (l.unitCost || 0))}</td>
                <td class="text-end"><button type="button" class="rs-remove" data-remove="${idx}" aria-label="Remove ${esc(ing?.name)}"><i class="bi bi-x-lg"></i></button></td>`;
            rows.appendChild(tr);
        });
        document.getElementById('noLines').hidden = lines.length > 0;
        fillAddPicker();
        totals();
    }

    function totals() {
        const total = lines.reduce((s, l) => s + (l.quantity || 0) * (l.unitCost || 0), 0);
        document.getElementById('receiptTotal').textContent = fmt(total);
        const counted = lines.filter(l => l.quantity > 0).length;
        document.getElementById('lineSummary').textContent = lines.length ? `${counted} of ${lines.length} item(s) with a quantity` : '';
    }

    // Items not on the receipt yet — the supplier's own first
    function fillAddPicker() {
        const pick = document.getElementById('addIngredient');
        const used = new Set(lines.map(l => l.ingredientId));
        pick.innerHTML = '<option value="">Add another item…</option>';
        const own = supplier()?.items.filter(i => !used.has(i.ingredientId)) || [];
        const ownIds = new Set(own.map(i => i.ingredientId));
        const group = (label, list) => {
            if (!list.length) return;
            const g = document.createElement('optgroup'); g.label = label;
            list.forEach(o => g.appendChild(new Option(o.label, o.id)));
            pick.appendChild(g);
        };
        group(supplier() ? `From ${supplier().name}` : 'Ingredients', own.map(i => ({ id: i.ingredientId, label: `${i.name} — R${fmt(i.unitPrice)} / ${i.unit}` })));
        group(supplier() ? 'Other ingredients' : '', ingredients.filter(i => !used.has(i.id) && !ownIds.has(i.id)).map(i => ({ id: i.id, label: i.name })));
    }

    function applySupplier(loadItems) {
        const s = supplier(), other = select.value === 'other';
        document.getElementById('supplierId').value = s ? s.id : '';
        document.getElementById('otherSupplier').hidden = !other;
        document.getElementById('supplierName').value = s ? s.name : (other ? document.getElementById('supplierName').value : '');
        const info = document.getElementById('supplierInfo');
        info.hidden = !s;
        if (s) info.innerHTML = `<div class="fw-bold">${esc(s.name)}</div>
            <div class="k-sub">${esc(s.contactName || '')}${s.phone ? ' · ' + esc(s.phone) : ''}</div>
            <div class="k-sub">${s.items.length} item(s) with fixed prices per unit</div>`;
        if (loadItems && s) lines = s.items.map(i => ({ ingredientId: i.ingredientId, quantity: i.defaultQuantity, unitCost: i.unitPrice }));
        render();
    }

    select.addEventListener('change', () => {
        if (lines.length && supplier() && !confirm('Replace the items listed with this supplier\'s items?')) { applySupplier(false); return; }
        applySupplier(true);
    });
    rows.addEventListener('input', e => {
        const tr = e.target.closest('tr'), idx = Array.from(rows.children).indexOf(tr);
        if (idx < 0) return;
        if (e.target.matches('[data-qty]')) lines[idx].quantity = parseFloat(e.target.value) || 0;
        if (e.target.matches('[data-price]')) lines[idx].unitCost = parseFloat(e.target.value) || 0;
        tr.querySelector('[data-line-total]').textContent = 'R' + fmt((lines[idx].quantity || 0) * (lines[idx].unitCost || 0));
        totals();
    });
    rows.addEventListener('click', e => {
        const btn = e.target.closest('[data-remove]');
        if (!btn) return;
        lines.splice(Number(btn.dataset.remove), 1);
        render();
    });
    document.getElementById('addLine').addEventListener('click', () => {
        const id = Number(document.getElementById('addIngredient').value);
        if (!id) { document.getElementById('addIngredient').focus(); return; }
        const own = supplierItem(id);
        lines.push({ ingredientId: id, quantity: own ? own.defaultQuantity : 0, unitCost: own ? own.unitPrice : 0 });
        render(id);
        rows.lastElementChild?.querySelector('[data-qty]')?.focus();
    });

    // ── Receipt document ──
    const docInput = document.getElementById('docInput');
    document.getElementById('takePhoto').addEventListener('click', () => { docInput.setAttribute('capture', 'environment'); docInput.accept = 'image/*'; docInput.click(); });
    document.getElementById('chooseFile').addEventListener('click', () => { docInput.removeAttribute('capture'); docInput.accept = 'image/*,application/pdf'; docInput.click(); });
    docInput.addEventListener('change', () => {
        const f = docInput.files[0], preview = document.getElementById('docPreview');
        document.getElementById('scanDrop').classList.toggle('has-file', !!f);
        document.getElementById('docError').hidden = true;
        if (!f) return;
        document.getElementById('scanIcon').className = 'bi bi-check-circle-fill big d-block mb-1 text-success';
        const label = document.getElementById('scanLabel');
        label.innerHTML = `<strong style="color:var(--dhs-navy)">${esc(f.name)}</strong><br><span class="k-sub">Use the buttons to retake or replace</span>`;
        if (f.type.startsWith('image/')) { preview.src = URL.createObjectURL(f); preview.hidden = false; } else preview.hidden = true;
    });

    // ── Save ──
    document.getElementById('receiptForm').addEventListener('submit', e => {
        const problems = [];
        if (!supplier() && !document.getElementById('supplierName').value.trim()) problems.push('Choose a supplier (or "Other supplier" and type the name).');
        const filled = lines.filter(l => l.quantity > 0);
        if (!filled.length) problems.push('Enter the quantity received for at least one item.');
        if (filled.some(l => !(l.unitCost > 0))) problems.push('Every item with a quantity needs a price per unit.');
        const err = document.getElementById('formError');
        err.hidden = problems.length === 0;
        err.innerHTML = problems.map(p => `<div><i class="bi bi-x-circle me-1"></i>${esc(p)}</div>`).join('');
        if (!docInput.files.length) {
            document.getElementById('docError').hidden = false;
            problems.push('doc');
        }
        if (problems.length) { e.preventDefault(); (problems[0] === 'doc' ? document.getElementById('scanDrop') : err).scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
        const btn = document.getElementById('saveBtn');
        btn.classList.add('is-busy');
        btn.querySelector('[data-label]').textContent = 'Saving…';
        setTimeout(() => btn.disabled = true, 0);
    });

    // ── Start: keep posted lines; "+ Stock" from Inventory picks the supplier who sells it ──
    if (!select.value && lines.length === 1) {
        const s = suppliers.find(s => s.items.some(i => i.ingredientId === lines[0].ingredientId));
        if (s) {
            select.value = String(s.id);
            const own = s.items.find(i => i.ingredientId === lines[0].ingredientId);
            lines[0].quantity = lines[0].quantity || own.defaultQuantity;
        }
    }
    applySupplier(false);
})();
</script>
}
