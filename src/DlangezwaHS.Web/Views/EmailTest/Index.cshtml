@{ ViewData["Title"] = "Email Test"; }

<div class="page-header">
    <h2><i class="bi bi-envelope-check me-2"></i>Email Configuration Test</h2>
    <p>Diagnose and test your SMTP settings</p>
</div>

<div class="row g-4">
    <!-- Current config -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-gear me-2"></i>Current SMTP Settings</h5></div>
            <div class="card-body">
                <table class="table table-sm table-dhs mb-3">
                    <tbody>
                        <tr><td class="fw-semibold" style="width:140px;">Host</td>
                            <td><code>@ViewBag.Host</code></td>
                            <td>@(ViewBag.Host == "sandbox.smtp.mailtrap.io" ? "✅ Mailtrap sandbox" : ViewBag.Host == "smtp.mailtrap.io" ? "⚠️ Old Mailtrap host" : "ℹ️ Custom")</td></tr>
                        <tr><td class="fw-semibold">Port</td><td><code>@ViewBag.Port</code></td><td></td></tr>
                        <tr><td class="fw-semibold">Username</td>
                            <td><code>@(string.IsNullOrEmpty(ViewBag.UserName as string) ? "⚠️ NOT SET" : ViewBag.UserName)</code></td>
                            <td>@(string.IsNullOrEmpty(ViewBag.UserName as string) ? "❌ Missing" : "✅")</td></tr>
                        <tr><td class="fw-semibold">Password</td>
                            <td><code>@((bool)ViewBag.HasPassword ? "••••••••" : "⚠️ NOT SET")</code></td>
                            <td>@((bool)ViewBag.HasPassword ? "✅" : "❌ Missing")</td></tr>
                        <tr><td class="fw-semibold">SSL</td><td><code>@ViewBag.UseSsl</code></td><td></td></tr>
                        <tr><td class="fw-semibold">From</td><td><code>@ViewBag.FromAddress</code></td><td></td></tr>
                    </tbody>
                </table>

                @if ((bool)ViewBag.HasPassword && !string.IsNullOrEmpty(ViewBag.UserName as string))
                {
                    <div class="alert alert-success py-2 small mb-0">
                        <i class="bi bi-check-circle me-1"></i>
                        Credentials are configured. Send a test email below to verify they work.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger py-2 small mb-0">
                        <i class="bi bi-x-circle me-1"></i>
                        <strong>SMTP credentials are missing.</strong> Follow the Mailtrap setup steps on the right.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Send test -->
    <div class="col-lg-6">
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0"><i class="bi bi-send me-2"></i>Send Test Email</h5></div>
            <div class="card-body">
                <form asp-action="Send" method="post">
                    @Html.AntiForgeryToken()
                    <label class="form-label fw-semibold">Send test email to:</label>
                    <div class="input-group">
                        <input type="email" name="toEmail" class="form-control"
                               placeholder="any@email.com" required />
                        <button type="submit" class="btn btn-dhs-primary">
                            <i class="bi bi-send me-1"></i>Send
                        </button>
                    </div>
                    <div class="form-text">
                        Use your Mailtrap inbox address, or any real email to test live sending.
                    </div>
                </form>
            </div>
        </div>

        <!-- Mailtrap setup guide -->
        <div class="card border-0" style="background:#f0f6fc;">
            <div class="card-body">
                <h6 class="fw-bold" style="color:#0B2A4A;">
                    <i class="bi bi-info-circle me-1"></i>Mailtrap Setup (Free — 3 minutes)
                </h6>
                <ol class="small text-muted mb-2 ps-3">
                    <li>Go to <a href="https://mailtrap.io" target="_blank">mailtrap.io</a> and sign in / create account</li>
                    <li>Click <strong>Email Testing → Inboxes</strong></li>
                    <li>Click your inbox → click <strong>Show Credentials</strong></li>
                    <li>Copy <strong>Username</strong> and <strong>Password</strong></li>
                    <li>Open <code>appsettings.Development.json</code> and update:</li>
                </ol>
                <pre class="small p-2 rounded" style="background:#e8f0f7;font-size:.78rem;">"Smtp": {
  "Host":     "sandbox.smtp.mailtrap.io",
  "Port":     587,
  "UserName": "PASTE_USERNAME_HERE",
  "Password": "PASTE_PASSWORD_HERE",
  "UseSsl":   false
}</pre>
                <div class="small text-muted mt-2">
                    <strong>Important:</strong> Edit <code>appsettings.<u>Development</u>.json</code>,
                    not <code>appsettings.json</code>. Then <strong>restart the app</strong>.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>
