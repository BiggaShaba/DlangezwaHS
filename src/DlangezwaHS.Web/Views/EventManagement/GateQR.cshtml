@{
    ViewData["Title"] = "Gate QR Code";
    string gateHash  = ViewBag.GateHash;
    string gateQrUrl = ViewBag.GateQrUrl;
    string title     = ViewBag.EventTitle;
}

<style>
.gate-wrap  { max-width:480px; margin:2rem auto; text-align:center; }
.gate-card  { border-radius:16px; overflow:hidden; box-shadow:0 8px 32px rgba(0,0,0,.12); border:1px solid #e5e7eb; }
.gate-top   { background:#1e3a5f; padding:28px; color:#fff; }
.gate-top h4{ margin:0; font-weight:800; }
.gate-body  { padding:32px; background:#fff; }
.gate-body img { width:280px; height:280px; border:6px solid #1e3a5f; border-radius:12px; }
.gate-warn  { background:#fee2e2; border:1px solid #ef4444; border-radius:8px;
              padding:12px 16px; font-size:.8rem; color:#7f1d1d; margin-top:16px; }
</style>

<div class="gate-wrap">
    <div class="gate-card">
        <div class="gate-top">
            <h4>🎫 Gate Ticket QR</h4>
            <p class="mb-0 mt-1" style="color:#93c5fd;font-size:.85rem">@title</p>
        </div>
        <div class="gate-body">
            <p class="text-muted small mb-3">
                Display or print this QR code at the gate. Each scan records one entry.
                This code can be used multiple times for gate sales.
            </p>
            <img src="@gateQrUrl" alt="Gate QR Code" />
            <div class="ticket-hash mt-2" style="font-family:monospace;font-size:.65rem;color:#9ca3af;word-break:break-all">
                @gateHash
            </div>
            <div class="gate-warn mt-3">
                🔒 For gate staff use only. Do not share publicly.
            </div>
            <button onclick="window.print()" class="btn btn-outline-primary btn-sm mt-3">
                🖨 Print Gate QR
            </button>
        </div>
    </div>
</div>

