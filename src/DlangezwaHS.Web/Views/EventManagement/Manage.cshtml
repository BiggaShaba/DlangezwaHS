@using DlangezwaHS.Web.Models.Domain
@using DlangezwaHS.Web.Services
@model SchoolEvent?
@{
    ViewData["Title"] = "Manage Event";
    int calendarEventId           = ViewBag.CalendarEventId;
    var roles      = (List<EventCoordinatorRole>)ViewBag.Roles;
    var candidates = (List<CoordinatorCandidateDto>)ViewBag.Candidates;
    var existing   = Model;
    bool isNew     = existing == null;
}

<style>
:root {
    --ev-dark:  #1e3a5f;
    --ev-green: #10b981;
    --ev-amber: #f59e0b;
    --ev-red:   #ef4444;
    --ev-card:  #fff;
    --ev-border:#e5e7eb;
}
.ev-header       { background:var(--ev-dark); color:#fff; border-radius:12px; padding:28px 32px; margin-bottom:2rem; }
.ev-header h3    { margin:0; font-weight:700; font-size:1.5rem; }
.ev-header p     { margin:4px 0 0; color:#93c5fd; font-size:.9rem; }
.ev-card         { border:1px solid var(--ev-border); border-radius:10px; background:var(--ev-card);
                   box-shadow:0 1px 4px rgba(0,0,0,.05); margin-bottom:1.5rem; overflow:hidden; }
.ev-card-header  { padding:16px 24px; border-bottom:1px solid var(--ev-border); background:#f9fafb;
                   font-weight:600; font-size:.9rem; color:var(--ev-dark); display:flex;
                   align-items:center; gap:.5rem; }
.ev-card-body    { padding:24px; }
.coord-row       { display:flex; gap:12px; align-items:center; margin-bottom:10px; flex-wrap:wrap; }
.coord-row .badge-type { font-size:.68rem; padding:2px 8px; border-radius:20px; font-weight:600; }
.coord-remove    { border:none; background:none; color:var(--ev-red); cursor:pointer; font-size:1.1rem;
                   padding:2px 6px; border-radius:4px; transition:background .15s; }
.coord-remove:hover { background:#fee2e2; }
.status-pill     { display:inline-flex; align-items:center; gap:6px; font-size:.78rem; font-weight:600;
                   border-radius:20px; padding:4px 12px; }
.stat-box        { border:1px solid var(--ev-border); border-radius:8px; padding:16px 20px; text-align:center; }
.stat-box .num   { font-size:2rem; font-weight:800; color:var(--ev-dark); }
.stat-box .lbl   { font-size:.75rem; color:#6b7280; margin-top:2px; }
</style>

<!-- Header -->
<div class="ev-header d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <h3>⚙️ @(isNew ? "Set Up School Event" : "Edit School Event")</h3>
        <p>Calendar Event ID: @calendarEventId
           @if (!isNew)
           {
               <span class="ms-3 status-pill @existing!.StatusBadge">
                   @existing.Status.ToString()
               </span>
           }
        </p>
    </div>
    @if (!isNew && existing!.IsPublished)
    {
        <div class="d-flex gap-2">
            <a asp-action="Scanner" asp-controller="EventManagement"
               asp-route-schoolEventId="@existing.Id"
               class="btn btn-sm btn-outline-light">📷 Scanner</a>
            <a asp-action="Summary" asp-controller="EventManagement"
               asp-route-schoolEventId="@existing.Id"
               class="btn btn-sm btn-outline-light">📊 Summary</a>
            <a asp-action="GateQR" asp-controller="EventManagement"
               asp-route-schoolEventId="@existing.Id"
               class="btn btn-sm btn-light text-dark">🎫 Gate QR</a>
        </div>
    }
</div>

<form id="eventForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="calendarEventId" value="@calendarEventId" />
    @if (!isNew)
    {
        <input type="hidden" id="schoolEventId" value="@existing!.Id" />
    }

    <div class="row g-4">
        <!-- LEFT: Core Details -->
        <div class="col-lg-7">

            <!-- Event Details -->
            <div class="ev-card">
                <div class="ev-card-header">📋 Event Details</div>
                <div class="ev-card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Venue</label>
                            <input type="text" name="venue" class="form-control"
                                   placeholder="e.g. School Hall, Sports Field"
                                   value="@(existing?.Venue)" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold small">Budget (R)</label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input type="number" name="budget" class="form-control"
                                       min="0" step="0.01" placeholder="0.00"
                                       value="@(existing?.Budget ?? 0)" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold small">Gate Ticket Price (R)</label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input type="number" name="gateTicketPrice" class="form-control"
                                       min="0" step="0.01" placeholder="0.00"
                                       value="@(existing?.GateTicketPrice ?? 0)" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">
                                Max Participants
                                <span class="text-muted fw-normal">(system generates this many QR tickets)</span>
                            </label>
                            <input type="number" name="maxParticipants" class="form-control"
                                   id="maxParticipants" min="1" placeholder="e.g. 200"
                                   value="@(existing?.MaxParticipants ?? 0)"
                                   oninput="updateTicketCount()" />
                            <div class="text-muted small mt-1" id="ticketCountHint"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Notes</label>
                            <textarea name="notes" class="form-control" rows="3"
                                      placeholder="Internal notes for coordinators...">@(existing?.Notes)</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats (if published) -->
            @if (!isNew && existing!.IsPublished)
            {
                <div class="ev-card">
                    <div class="ev-card-header">📈 Live Stats</div>
                    <div class="ev-card-body">
                        <div class="row g-3">
                            <div class="col-4">
                                <div class="stat-box">
                                    <div class="num">@existing.RSVPCount</div>
                                    <div class="lbl">RSVPs Confirmed</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-box">
                                    <div class="num">@existing.ScannedCount</div>
                                    <div class="lbl">Checked In</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-box">
                                    <div class="num">@existing.MaxParticipants</div>
                                    <div class="lbl">Max Capacity</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT: Coordinators -->
        <div class="col-lg-5">
            <div class="ev-card">
                <div class="ev-card-header justify-content-between">
                    <span>👥 Event Coordinators</span>
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            data-bs-toggle="modal" data-bs-target="#addCoordModal">+ Add</button>
                </div>
                <div class="ev-card-body p-0">
                    <div id="coordList" class="p-3">
                        @if (existing?.Coordinators.Any(c => c.IsActive) == true)
                        {
                            @foreach (var c in existing.Coordinators.Where(c => c.IsActive))
                            {
                                <div class="coord-row" id="coord-@c.Id">
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@c.CoordinatorName</div>
                                        <span class="badge-type"
                                              style="background:@(c.CoordinatorType=="Teacher"?"#dbeafe":"#d1fae5");
                                                     color:@(c.CoordinatorType=="Teacher"?"#1d4ed8":"#065f46")">
                                            @c.CoordinatorType
                                        </span>
                                    </div>
                                    <span class="badge bg-secondary">@c.Role.Name</span>
                                    <input type="hidden" name="coordinatorUserIds" value="@c.UserId" />
                                    <input type="hidden" name="coordinatorRoleIds" value="@c.RoleId" />
                                    <button type="button" class="coord-remove"
                                            onclick="removeCoord(@c.Id, this)" title="Remove">×</button>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small text-center py-3" id="noCoordMsg">
                                No coordinators assigned yet.
                            </p>
                        }
                    </div>
                </div>

                <!-- Add Custom Role -->
                <div class="ev-card-body border-top pt-3">
                    <p class="small fw-semibold mb-2">Add Custom Coordinator Role</p>
                    <div class="input-group input-group-sm">
                        <input type="text" id="newRoleName" class="form-control"
                               placeholder="e.g. Catering Manager" />
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="addCustomRole()">Add Role</button>
                    </div>
                    <div class="mt-2">
                        <p class="small text-muted mb-1">Current roles:</p>
                        <div id="roleTagList">
                            @foreach (var r in roles)
                            {
                                <span class="badge bg-light text-dark border me-1 mb-1">@r.Name</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Save / Publish Buttons -->
    <div class="d-flex gap-3 justify-content-end mt-2 mb-5">
        <a href="@Url.Action("Index","Calendar")" class="btn btn-outline-secondary">Cancel</a>
        <button type="button" class="btn btn-outline-primary" onclick="saveEvent(false)">
            💾 Save Draft
        </button>
        <button type="button" class="btn text-white" style="background:var(--ev-dark)"
                onclick="saveEvent(true)">
            🚀 Publish & Save to Calendar
        </button>
    </div>
</form>

<!-- ═══ Add Coordinator Modal ═══ -->
<div class="modal fade" id="addCoordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:var(--ev-dark);color:#fff">
                <h5 class="modal-title">Add Coordinator</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Search person</label>
                    <input type="text" id="coordSearch" class="form-control"
                           placeholder="Type name to filter…" oninput="filterCandidates()" />
                </div>
                <div id="candidateList" style="max-height:260px;overflow-y:auto">
                    @foreach (var c in candidates)
                    {
                        <div class="candidate-item d-flex justify-content-between align-items-center
                                    border rounded p-2 mb-2 cursor-pointer"
                             data-name="@c.Name.ToLower()" data-userid="@c.UserId"
                             data-username="@c.Name" data-type="@c.Type"
                             onclick="selectCandidate(this)">
                            <div>
                                <div class="fw-semibold small">@c.Name</div>
                                <div class="text-muted" style="font-size:.72rem">@c.Email</div>
                            </div>
                            <span class="badge" style="background:@(c.Type=="Teacher"?"#dbeafe":"#d1fae5");
                                  color:@(c.Type=="Teacher"?"#1d4ed8":"#065f46");font-size:.68rem">
                                @c.Type
                            </span>
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <label class="form-label fw-semibold small">Assign Role</label>
                    <select id="coordRoleSelect" class="form-select">
                        @foreach (var r in roles)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="confirmAddCoord()">
                    Add to Event
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let selectedCandidate = null;
    const antiForgery = () =>
        document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    // ── Ticket count hint ───────────────────────────────────────────────────
    function updateTicketCount() {
        const n   = parseInt(document.getElementById('maxParticipants').value) || 0;
        const hint= document.getElementById('ticketCountHint');
        hint.textContent = n > 0
            ? `${n} unique RSVP QR codes will be generated on demand. 1 shared gate QR will be created.`
            : '';
    }
    updateTicketCount();

    // ── Candidate filter ────────────────────────────────────────────────────
    function filterCandidates() {
        const q = document.getElementById('coordSearch').value.toLowerCase();
        document.querySelectorAll('.candidate-item').forEach(el => {
            el.style.display = el.dataset.name.includes(q) ? '' : 'none';
        });
    }

    function selectCandidate(el) {
        document.querySelectorAll('.candidate-item').forEach(e => e.classList.remove('border-primary','bg-primary','bg-opacity-10'));
        el.classList.add('border-primary','bg-primary','bg-opacity-10');
        selectedCandidate = { userId: el.dataset.userid, name: el.dataset.username, type: el.dataset.type };
    }

    // ── Add coordinator to local list ────────────────────────────────────────
    function confirmAddCoord() {
        if (!selectedCandidate) { alert('Please select a person.'); return; }
        const roleId   = document.getElementById('coordRoleSelect').value;
        const roleName = document.getElementById('coordRoleSelect').selectedOptions[0].text;

        const noMsg = document.getElementById('noCoordMsg');
        if (noMsg) noMsg.remove();

        const row = document.createElement('div');
        row.className = 'coord-row';
        row.innerHTML = `
            <div class="flex-grow-1">
                <div class="fw-semibold small">${selectedCandidate.name}</div>
                <span class="badge-type" style="background:${selectedCandidate.type==='Teacher'?'#dbeafe':'#d1fae5'};color:${selectedCandidate.type==='Teacher'?'#1d4ed8':'#065f46'}">
                    ${selectedCandidate.type}
                </span>
            </div>
            <span class="badge bg-secondary">${roleName}</span>
            <input type="hidden" name="coordinatorUserIds" value="${selectedCandidate.userId}" />
            <input type="hidden" name="coordinatorRoleIds" value="${roleId}" />
            <button type="button" class="coord-remove" onclick="this.closest('.coord-row').remove()">×</button>`;
        document.getElementById('coordList').appendChild(row);

        bootstrap.Modal.getInstance(document.getElementById('addCoordModal')).hide();
        selectedCandidate = null;
    }

    // ── Remove existing coordinator (server-side) ────────────────────────────
    async function removeCoord(coordId, btn) {
        const fd = new FormData();
        fd.append('coordinatorId', coordId);
        fd.append('__RequestVerificationToken', antiForgery());
        const res  = await fetch('@Url.Action("RemoveCoordinator","EventManagement")', { method:'POST', body:fd });
        const data = await res.json();
        if (data.success) btn.closest('.coord-row').remove();
    }

    // ── Add custom role ──────────────────────────────────────────────────────
    async function addCustomRole() {
        const name = document.getElementById('newRoleName').value.trim();
        if (!name) return;
        const fd = new FormData();
        fd.append('name', name);
        fd.append('__RequestVerificationToken', antiForgery());
        const res  = await fetch('@Url.Action("AddRole","EventManagement")', { method:'POST', body:fd });
        const data = await res.json();
        if (data.success) {
            // Refresh role list in select + tag list
            const sel = document.getElementById('coordRoleSelect');
            const tags= document.getElementById('roleTagList');
            data.roles.forEach(r => {
                if (!sel.querySelector(`option[value="${r.id}"]`)) {
                    sel.add(new Option(r.name, r.id));
                    tags.insertAdjacentHTML('beforeend',
                        `<span class="badge bg-light text-dark border me-1 mb-1">${r.name}</span>`);
                }
            });
            document.getElementById('newRoleName').value = '';
        }
    }

    // ── Save / Publish ───────────────────────────────────────────────────────
    async function saveEvent(publish) {
        const form = document.getElementById('eventForm');
        const fd   = new FormData(form);
        const btn  = event.target;
        btn.disabled = true;
        btn.textContent = 'Saving…';

        // Save details first
        const saveRes  = await fetch('@Url.Action("Save","EventManagement")', { method:'POST', body:fd });
        const saveData = await saveRes.json();

        if (!saveData.success) {
            showToast(saveData.message, 'danger');
            btn.disabled = false; btn.textContent = publish ? '🚀 Publish & Save to Calendar' : '💾 Save Draft';
            return;
        }

        if (publish) {
            // Get the newly-created schoolEventId from the hidden field or redirect
            // We'll redirect to manage page to pick up the ID, then publish
            const schoolEventId = document.getElementById('schoolEventId')?.value;
            if (schoolEventId) {
                const pfd = new FormData();
                pfd.append('schoolEventId', schoolEventId);
                pfd.append('__RequestVerificationToken', antiForgery());
                const pRes  = await fetch('@Url.Action("Publish","EventManagement")', { method:'POST', body:pfd });
                const pData = await pRes.json();
                showToast(pData.message, pData.success ? 'success' : 'danger');
            } else {
                showToast('Event saved as draft. Reload page to publish.', 'warning');
            }
        } else {
            showToast('Event saved as draft.', 'success');
        }

        btn.disabled = false;
        btn.textContent = publish ? '🚀 Publish & Save to Calendar' : '💾 Save Draft';
        setTimeout(() => location.reload(), 1200);
    }

    function showToast(msg, type) {
        const t = document.createElement('div');
        t.className = `alert alert-${type} position-fixed top-0 end-0 m-3 shadow`;
        t.style.cssText = 'z-index:9999;min-width:280px';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 3500);
    }
</script>
}
