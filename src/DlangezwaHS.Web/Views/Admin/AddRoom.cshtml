@* AddRoom.cshtml *@
@model AddRoomViewModel
@{ ViewData["Title"] = "Add Room"; }
<div class="row justify-content-center">
<div class="col-md-6">
<div class="page-header"><h2><i class="bi bi-building-add me-2"></i>Add Room</h2></div>
<div class="card">
    <div class="card-body p-4">
        <form asp-action="AddRoom" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Room Name / Number <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. R1, Block A Room 3" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Capacity" class="form-label">Capacity</label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" max="100" />
            </div>
            <div class="mb-3">
                <label asp-for="BedCount" class="form-label">Auto-create beds</label>
                <input asp-for="BedCount" class="form-control" type="number" min="0" max="50" />
                <div class="form-text">Beds will be named B1, B2, etc. You can add more later.</div>
            </div>
            <div class="mb-4">
                <label asp-for="Notes" class="form-label">Notes (optional)</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dhs-primary"><i class="bi bi-check me-1"></i> Save Room</button>
                <a asp-action="Rooms" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
