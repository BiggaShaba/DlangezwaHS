@model ApplicationListViewModel
@{ ViewData["Title"] = "Applications"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-file-earmark-text me-2"></i>Applications</h2>
        <p>Review and process learner applications</p>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Learner name or parent email…" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in new[] { "pending","approved","rejected","enrolled" })
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@(s[0].ToString().ToUpper() + s[1..])
                        </option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dhs-primary btn-sm">
                    <i class="bi bi-search me-1"></i> Filter
                </button>
                <a asp-action="Applications" class="btn btn-outline-secondary btn-sm ms-1">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Applications.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3" style="color:#97C8E9;"></i>
                <h5>No applications found</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dhs table-hover mb-0">
                    <thead>
                    <tr>
                        <th>#</th><th>Learner</th><th>Parent / Guardian</th>
                        <th>Submitted</th><th>Status</th><th class="text-center">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var a in Model.Applications)
                    {
                        <tr>
                            <td><small class="text-muted">@a.Id</small></td>
                            <td><strong>@a.LearnerName</strong></td>
                            <td>
                                <div>@a.ParentName</div>
                                <small class="text-muted">@a.ParentEmail</small>
                            </td>
                            <td><small>@a.SubmittedAt.ToString("dd MMM yyyy HH:mm")</small></td>
                            <td>
                                <span class="badge rounded-pill badge-@a.Status.ToString().ToLower()">
                                    @a.Status
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-action="ApplicationDetail" asp-route-id="@a.Id"
                                   class="btn btn-sm btn-dhs-primary">
                                    <i class="bi bi-eye"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
