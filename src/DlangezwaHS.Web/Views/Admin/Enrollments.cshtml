@* Enrollments.cshtml *@
@model List<Enrollment>
@{ ViewData["Title"] = "Enrollments"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h2><i class="bi bi-person-badge me-2"></i>Enrollments</h2><p>All active enrolled learners</p></div>
    <a asp-action="ExportEnrollments" class="btn btn-dhs-secondary"><i class="bi bi-download me-1"></i>Export CSV</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dhs table-hover mb-0">
                <thead><tr><th>#</th><th>Learner</th><th>Class</th><th>Subjects</th><th>Enrolled</th><th></th></tr></thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="text-muted small">@e.Id</td>
                        <td><strong>@e.Learner?.FullName</strong><br/><small class="text-muted">@e.Learner?.LearnerIdNumber</small></td>
                        <td><span class="badge" style="background:#dbeafe;color:#1e40af;">@e.Class?.DisplayName</span></td>
                        <td>
                            @foreach (var s in e.EnrollmentSubjects.Take(3))
                            {
                                <span class="badge bg-light text-dark border me-1 small">@s.Subject?.Code</span>
                            }
                            @if (e.EnrollmentSubjects.Count > 3) { <span class="text-muted small">+@(e.EnrollmentSubjects.Count - 3)</span> }
                        </td>
                        <td><small>@e.EnrolledAt.ToString("dd MMM yyyy")</small></td>
                        <td><a asp-action="EnrollmentDetail" asp-route-id="@e.Id" class="btn btn-sm btn-dhs-primary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
