@model ManualPaymentViewModel
@{ ViewData["Title"] = "Record Payment"; }

<div class="row justify-content-center">
<div class="col-md-6">
<div class="page-header">
    <h2><i class="bi bi-cash-coin me-2"></i>Record Manual Payment</h2>
    <p>Learner: <strong>@Model.LearnerName</strong></p>
</div>
<div class="card">
    <div class="card-body p-4">
        <form asp-action="RecordPayment" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="LearnerId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>
            <div class="mb-3">
                <label asp-for="Type" class="form-label">Payment Type <span class="text-danger">*</span></label>
                <select asp-for="Type" class="form-select">
                    <option value="Registration">Registration Fee (R2,567)</option>
                    <option value="Accommodation">Accommodation Fee (R5,439)</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Amount" class="form-label">Amount (ZAR) <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text">R</span>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="1" />
                </div>
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BankRef" class="form-label">Bank Transfer Reference <span class="text-danger">*</span></label>
                <input asp-for="BankRef" class="form-control" placeholder="e.g. FNB123456" />
                <span asp-validation-for="BankRef" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Notes" class="form-label">Notes (optional)</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dhs-primary"><i class="bi bi-check me-1"></i> Save Payment</button>
                <a asp-action="Enrollments" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
