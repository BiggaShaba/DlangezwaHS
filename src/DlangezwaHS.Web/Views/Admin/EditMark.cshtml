@model AdminEditMarkViewModel
@{ ViewData["Title"] = "Edit Mark"; }

<div class="page-header">
    <nav aria-label="breadcrumb"><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="AcademicReports">Academic Reports</a></li>
        <li class="breadcrumb-item active">Edit Mark</li>
    </ol></nav>
    <h2><i class="bi bi-pencil-square me-2"></i>Edit Mark (Admin Override)</h2>
</div>

<div class="row justify-content-center">
<div class="col-md-6">
<div class="alert alert-warning mb-4">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    <strong>Admin Override:</strong> This mark has been submitted by the teacher.
    All changes are logged in the audit trail.
</div>
<div class="card">
    <div class="card-body p-4">
        <div class="mb-4">
            <div class="small text-muted">Learner</div>
            <div class="fw-bold">@Model.LearnerName</div>
            <div class="small text-muted mt-1">Assessment</div>
            <div class="fw-semibold">@Model.AssessmentName (Total: @Model.TotalMarks)</div>
        </div>
        <form asp-action="EditMark" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="MarkId" type="hidden" />
            <div class="mb-3">
                <label asp-for="MarksObtained" class="form-label">New Marks <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input asp-for="MarksObtained" class="form-control" type="number" step="0.5" min="0" max="@Model.TotalMarks" />
                    <span class="input-group-text">/ @Model.TotalMarks</span>
                </div>
                <span asp-validation-for="MarksObtained" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Comments" class="form-label">Comments</label>
                <input asp-for="Comments" class="form-control" />
            </div>
            <div class="mb-4">
                <label asp-for="AdminReason" class="form-label">Reason for Change <span class="text-danger">*</span></label>
                <textarea asp-for="AdminReason" class="form-control" rows="2"
                          placeholder="Required — will be recorded in audit log" required></textarea>
                <span asp-validation-for="AdminReason" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning px-4">
                    <i class="bi bi-check me-1"></i>Save Override
                </button>
                <a asp-action="AcademicReports" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
