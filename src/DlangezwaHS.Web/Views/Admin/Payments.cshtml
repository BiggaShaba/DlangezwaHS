@model List<Payment>
@{ ViewData["Title"] = "Payments"; }

<div class="page-header"><h2><i class="bi bi-credit-card me-2"></i>Payments</h2><p>All fee transactions</p></div>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Payments" class="btn btn-sm @(ViewContext.RouteData.Values["status"] == null ? "btn-dhs-primary" : "btn-outline-secondary")">All</a>
    <a asp-action="Payments" asp-route-status="completed" class="btn btn-sm btn-outline-success">Completed</a>
    <a asp-action="Payments" asp-route-status="pending" class="btn btn-sm btn-outline-warning">Pending</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dhs mb-0">
                <thead><tr><th>#</th><th>Learner</th><th>Type</th><th>Amount</th><th>Method</th><th>Reference</th><th>Date</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="text-muted small">@p.Id</td>
                        <td><strong>@p.Learner?.FullName</strong></td>
                        <td>@p.Type</td>
                        <td class="@(p.Status == PaymentStatus.Completed ? "text-success fw-bold" : "")">R@(p.Amount.ToString("N2"))</td>
                        <td><small>@p.Method</small></td>
                        <td><code class="small">@(p.ProviderRef ?? p.BankRef ?? "-")</code></td>
                        <td><small>@(p.PaidAt.HasValue ? p.PaidAt.Value.ToString("dd MMM yyyy") : p.CreatedAt.ToString("dd MMM yyyy"))</small></td>
                        <td><span class="badge rounded-pill @(p.Status == PaymentStatus.Completed ? "badge-approved" : p.Status == PaymentStatus.Pending ? "badge-pending" : "badge-rejected")">@p.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <strong>Total collected: </strong>
    <span class="text-success fw-bold">R@(Model.Where(p => p.Status == PaymentStatus.Completed).Sum(p => p.Amount).ToString("N2"))</span>
</div>
