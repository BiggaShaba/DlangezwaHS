@using Microsoft.AspNetCore.Mvc.Rendering
@model FuelReportViewModel
@{ ViewData["Title"] = "Fuel Report"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2><i class="bi bi-bar-chart me-2"></i>Fuel Report</h2></div>
    <a asp-action="FuelReportPdf" asp-route-busId="@Model.BusId" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" class="btn btn-dhs-secondary">
        <i class="bi bi-file-earmark-pdf me-1"></i>Export PDF
    </a>
</div>

<div class="card mb-4">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small">Bus</label>
                <select name="busId" class="form-select form-select-sm">
                    <option value="">All Buses</option>
                    @foreach (var b in Model.Buses)
                    { <option value="@b.Id" selected="@(Model.BusId == b.Id)">@b.RegistrationNumber</option> }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small">From</label>
                <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label class="form-label small">To</label>
                <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-dhs-primary btn-sm">Filter</button></div>
        </form>
    </div>
</div>

@if (Model.Report is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted small">Total Fuel Used</div><div class="fs-4 fw-bold">@Model.Report.TotalLitres.ToString("N1") L</div></div></div></div>
        <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted small">Total Cost</div><div class="fs-4 fw-bold">R @Model.Report.TotalCost.ToString("N2")</div></div></div></div>
        <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted small">Average Efficiency</div><div class="fs-4 fw-bold">@(Model.Report.AverageEfficiency.HasValue ? $"{Model.Report.AverageEfficiency:N2} km/L" : "—")</div></div></div></div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            @if (!Model.Report.Records.Any())
            {
                <div class="p-4 text-center text-muted">No fuel records in this period.</div>
            }
            else
            {
                <table class="table table-dhs mb-0">
                    <thead><tr><th>Date</th><th>Bus</th><th>Litres</th><th>Cost</th><th>Odometer</th><th>Station</th><th>Efficiency</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Report.Records)
                    {
                        <tr>
                            <td>@r.Date.ToString("dd MMM yyyy")</td>
                            <td>@r.Bus?.RegistrationNumber</td>
                            <td>@r.Litres.ToString("N1") L</td>
                            <td>R @r.TotalCost.ToString("N2")</td>
                            <td>@r.OdometerReading.ToString("N0")</td>
                            <td>@r.StationName</td>
                            <td>@(r.EfficiencyKmPerLitre.HasValue ? $"{r.EfficiencyKmPerLitre:N2} km/L" : "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
