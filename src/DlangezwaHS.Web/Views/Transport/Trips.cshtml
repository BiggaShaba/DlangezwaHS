@model IList<Trip>
@{ ViewData["Title"] = "Trips"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2><i class="bi bi-signpost-split me-2"></i>Transport Trips</h2></div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="ScheduleTransport" class="btn btn-dhs-primary"><i class="bi bi-plus-circle me-1"></i>Schedule Transport</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-bus-front fs-1 d-block mb-2" style="color:#97C8E9;"></i>
                No transport scheduled yet.
            </div>
        }
        else
        {
            <table class="table table-dhs mb-0">
                <thead><tr><th>Route</th><th>Purpose</th><th>Bus</th><th>Driver</th><th>Schedule</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Route</td>
                        <td>@t.Purpose @(!string.IsNullOrEmpty(t.PurposeDetail) ? $"– {t.PurposeDetail}" : "")</td>
                        <td>@t.Bus?.RegistrationNumber</td>
                        <td>@t.Driver?.FullName</td>
                        <td><small>@(t.IsRecurring ? t.DaysOfWeek : t.TripDate?.ToString("dd MMM yyyy")) · @t.DepartureTime.ToString(@"hh\:mm")–@t.ArrivalTime.ToString(@"hh\:mm")</small></td>
                        <td><span class="badge rounded-pill @(t.Status == TripStatus.Cancelled ? "badge-rejected" : "badge-approved")">@t.Status</span></td>
                        <td class="d-flex gap-1">
                            <a asp-action="BoardTheBus" asp-route-tripId="@t.Id" class="btn btn-sm btn-dhs-primary" title="Board the Bus"><i class="bi bi-clipboard-check"></i></a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                            {
                                <a asp-action="ReportDelay" asp-route-tripId="@t.Id" class="btn btn-sm btn-outline-warning" title="Report Delay"><i class="bi bi-clock-history"></i></a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
