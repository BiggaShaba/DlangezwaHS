@using Microsoft.AspNetCore.Mvc.Rendering
@model IList<FuelRecord>
@{ ViewData["Title"] = "Fuel Records"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><h2><i class="bi bi-fuel-pump me-2"></i>Fuel Management</h2></div>
    <div class="d-flex gap-2">
        <a asp-action="FuelReport" class="btn btn-dhs-secondary"><i class="bi bi-bar-chart me-1"></i>Fuel Report</a>
        <a asp-action="FuelRecordCreate" class="btn btn-dhs-primary"><i class="bi bi-plus-circle me-1"></i>Add Fuel Record</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex align-items-center gap-2">
            <label class="form-label small mb-0">Bus:</label>
            <select name="busId" class="form-select form-select-sm" style="max-width:220px;" onchange="this.form.submit()">
                <option value="">All Buses</option>
                @foreach (var b in (IList<Bus>)ViewBag.Buses)
                {
                    <option value="@b.Id" selected="@(ViewBag.SelBus == b.Id)">@b.RegistrationNumber</option>
                }
            </select>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">No fuel records yet.</div>
        }
        else
        {
            <table class="table table-dhs mb-0">
                <thead><tr><th>Date</th><th>Bus</th><th>Litres</th><th>Cost</th><th>Odometer</th><th>Station</th><th>Efficiency</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Date.ToString("dd MMM yyyy")</td>
                        <td>@r.Bus?.RegistrationNumber</td>
                        <td>@r.Litres.ToString("N1") L</td>
                        <td>R @r.TotalCost.ToString("N2")</td>
                        <td>@r.OdometerReading.ToString("N0")</td>
                        <td>@r.StationName</td>
                        <td>@(r.EfficiencyKmPerLitre.HasValue ? $"{r.EfficiencyKmPerLitre:N2} km/L" : "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
