@using Microsoft.AspNetCore.Mvc.Rendering
@model ScheduleTransportViewModel
@{ ViewData["Title"] = "Schedule Transport"; }

<div class="page-header"><h2><i class="bi bi-signpost-split me-2"></i>Schedule Transport</h2></div>

<form asp-action="ScheduleTransport" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Bus <span class="text-danger">*</span></label>
                    <select asp-for="BusId" asp-items="@(new SelectList(Model.Buses, "Id", "RegistrationNumber"))" class="form-select">
                        <option value="">Select bus…</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Driver <span class="text-danger">*</span></label>
                    <select asp-for="DriverId" asp-items="@(new SelectList(Model.Drivers, "Id", "FullName"))" class="form-select">
                        <option value="">Select driver…</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Route</label>
                    <select asp-for="Route" asp-items="Html.GetEnumSelectList<TransportRoute>()" class="form-select"></select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Purpose</label>
                    <select asp-for="Purpose" asp-items="Html.GetEnumSelectList<TransportPurpose>()" class="form-select"></select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Purpose Detail (optional)</label>
                    <input asp-for="PurposeDetail" class="form-control" placeholder="e.g. Soccer vs St Mary's" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Departure Time</label>
                    <input asp-for="DepartureTime" type="time" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Arrival Time</label>
                    <input asp-for="ArrivalTime" type="time" class="form-control" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsRecurring" class="form-check-input" id="isRecurring" />
                        <label class="form-check-label" for="isRecurring">Daily Shuttle (recurring)</label>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="RosterIsAllBoardingLearners" class="form-check-input" id="rosterAll" />
                        <label class="form-check-label" for="rosterAll">All Boarding Learners</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3" id="recurringPanel">
        <div class="card-header"><strong>Days of Week</strong></div>
        <div class="card-body d-flex gap-3 flex-wrap align-items-end">
            @foreach (var day in new[] { "Mon", "Tue", "Wed", "Thu", "Fri" })
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="SelectedDays" value="@day"
                           id="day_@day" checked="@(Model.SelectedDays.Contains(day))" />
                    <label class="form-check-label" for="day_@day">@day</label>
                </div>
            }
            <div class="ms-auto" style="min-width:220px;">
                <label class="form-label small mb-0">Recurrence End (optional)</label>
                <input asp-for="RecurrenceEndDate" type="date" class="form-control form-control-sm" />
            </div>
        </div>
    </div>

    <div class="card mb-3" id="oneOffPanel">
        <div class="card-header"><strong>Trip Date</strong></div>
        <div class="card-body">
            <input asp-for="TripDate" type="date" class="form-control" style="max-width:220px;" />
        </div>
    </div>

    <div class="card mb-3" id="rosterPanel">
        <div class="card-header"><strong>Select Learners</strong> <span class="text-muted small">(sport / cultural trips only)</span></div>
        <div class="card-body" style="max-height:260px;overflow-y:auto;">
            @if (!Model.BoardingLearners.Any())
            {
                <p class="text-muted mb-0">No boarding learners on record yet.</p>
            }
            @foreach (var l in Model.BoardingLearners)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="SelectedLearnerIds" value="@l.Id"
                           id="learner_@l.Id" checked="@(Model.SelectedLearnerIds.Contains(l.Id))" />
                    <label class="form-check-label" for="learner_@l.Id">@l.FullName</label>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-dhs-primary px-4"><i class="bi bi-check-circle me-1"></i>Schedule</button>
        <a asp-action="Trips" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
function toggleRoster() {
    var recurring = document.getElementById('isRecurring').checked;
    document.getElementById('recurringPanel').style.display = recurring ? '' : 'none';
    document.getElementById('oneOffPanel').style.display = recurring ? 'none' : '';
    var allBoarding = document.getElementById('rosterAll').checked;
    document.getElementById('rosterPanel').style.display = allBoarding ? 'none' : '';
}
document.getElementById('isRecurring').addEventListener('change', toggleRoster);
document.getElementById('rosterAll').addEventListener('change', toggleRoster);
document.addEventListener('DOMContentLoaded', toggleRoster);
</script>
<partial name="_ValidationScriptsPartial" />
}
