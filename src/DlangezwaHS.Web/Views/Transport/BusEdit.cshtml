@model BusEditViewModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit Bus" : "Add Bus"; }

<div class="row justify-content-center">
<div class="col-md-6">
<div class="page-header"><h2><i class="bi bi-bus-front me-2"></i>@ViewData["Title"]</h2></div>
<div class="card">
    <div class="card-body p-4">
        <form asp-action="BusEdit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>
            <div class="mb-3">
                <label asp-for="RegistrationNumber" class="form-label">Registration Number <span class="text-danger">*</span></label>
                <input asp-for="RegistrationNumber" class="form-control" placeholder="e.g. ND 123-456" />
                <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MakeModel" class="form-label">Make / Model <span class="text-danger">*</span></label>
                <input asp-for="MakeModel" class="form-control" placeholder="e.g. Toyota Quantum" />
                <span asp-validation-for="MakeModel" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Capacity" class="form-label">Capacity</label>
                <input asp-for="Capacity" type="number" min="1" max="120" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dhs-primary px-4"><i class="bi bi-check me-1"></i>Save Bus</button>
                <a asp-action="Buses" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
