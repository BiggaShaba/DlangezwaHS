@model ReportDelayViewModel
@{ ViewData["Title"] = "Report Delay"; }

<div class="row justify-content-center">
<div class="col-md-7">
<div class="page-header">
    <h2><i class="bi bi-clock-history me-2"></i>Report Delay</h2>
    <p>@Model.TripLabel — @Model.Date.ToString("dddd, dd MMMM yyyy")</p>
</div>

<div class="card mb-3">
    <div class="card-body p-4">
        <form asp-action="ReportDelay" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TripId" />
            <input type="hidden" asp-for="OccurrenceId" />
            <input type="hidden" asp-for="Date" />

            <div class="mb-3">
                <label asp-for="Reason" class="form-label">Reason <span class="text-danger">*</span></label>
                <select asp-for="Reason" asp-items="Html.GetEnumSelectList<DelayReason>()" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="NewEta" class="form-label">New Estimated Arrival Time <span class="text-danger">*</span></label>
                <input asp-for="NewEta" type="time" class="form-control" style="max-width:200px;" />
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notes (optional)</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dhs-primary px-4"><i class="bi bi-send me-1"></i>Submit</button>
                <a asp-action="BoardTheBus" asp-route-tripId="@Model.TripId" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@if (Model.PastReports.Any())
{
    <div class="card">
        <div class="card-header"><strong>Past Delay Reports for this Day</strong></div>
        <div class="card-body p-0">
            <table class="table table-dhs mb-0">
                <thead><tr><th>Reported</th><th>Reason</th><th>New ETA</th><th>By</th></tr></thead>
                <tbody>
                @foreach (var r in Model.PastReports)
                {
                    <tr>
                        <td><small>@r.ReportedAt.ToString("HH:mm")</small></td>
                        <td>@r.Reason</td>
                        <td>@r.NewEta.ToString(@"hh\:mm")</td>
                        <td>@r.ReportedByName</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
</div>
</div>
