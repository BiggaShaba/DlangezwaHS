@* Register.cshtml *@
@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <span style="font-size:3rem;color:#0B2A4A;"><i class="bi bi-person-plus-fill"></i></span>
            <h2 class="fw-bold mt-2" style="color:#0B2A4A;">Parent Registration</h2>
            <p class="text-muted">Create an account to apply on behalf of your learner.</p>
        </div>
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="First name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Last name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="your@email.com" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" placeholder="0xx xxx xxxx" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Min 8 chars, 1 uppercase, 1 number, 1 symbol" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-dhs-primary w-100 mt-4 py-2">
                        <i class="bi bi-person-check me-1"></i> Create Account
                    </button>
                </form>
            </div>
        </div>
        <p class="text-center mt-3 text-muted small">Already have an account?
            <a asp-action="Login" class="fw-semibold" style="color:#0B2A4A;">Sign in</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
