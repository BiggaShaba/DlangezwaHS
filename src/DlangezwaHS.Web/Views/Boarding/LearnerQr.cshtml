@model Learner
@{ ViewData["Title"] = "Boarding QR Badge"; }

<div class="page-header">
    <nav aria-label="breadcrumb"><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Boarders">Boarders</a></li>
        <li class="breadcrumb-item active">QR Badge</li>
    </ol></nav>
    <h2><i class="bi bi-qr-code me-2"></i>@Model.FullName</h2>
    <p>Print this badge for the learner to present at the boarding scanner</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card text-center">
            <div class="card-body p-4">
                <div id="qr" class="d-flex justify-content-center mb-3"></div>
                <h5 class="fw-bold" style="color:#0B2A4A;">@Model.FullName</h5>
                <p class="text-muted small mb-0">@Model.LearnerIdNumber</p>
                <hr />
                <p class="text-muted small">Badge code: <code>@ViewBag.QrCode</code></p>
                <a asp-action="Boarders" class="btn btn-outline-secondary btn-sm">Back to Boarders</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
    new QRCode(document.getElementById("qr"), {
        text: "@ViewBag.QrCode",
        width: 220,
        height: 220
    });
</script>
}
