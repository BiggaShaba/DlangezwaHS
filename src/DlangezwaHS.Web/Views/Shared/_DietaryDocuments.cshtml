@model IList<DietaryDocumentRow>
@*
    Supporting documents for a dietary profile. Each controller that renders this
    (Parent, Learner, Boarding, KitchenStaff) has its own access-checked DietaryDocument action.
*@
@if (Model.Any())
{
    <ul class="list-unstyled mb-0 small">
        @foreach (var d in Model)
        {
            var icon = d.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ? "bi-file-earmark-pdf" : "bi-file-earmark-image";
            <li>
                <a asp-action="DietaryDocument" asp-route-id="@d.Id" target="_blank" rel="noopener">
                    <i class="bi @icon me-1"></i>@d.FileName
                </a>
                <span class="text-muted">(@(d.FileSizeBytes >= 1024 * 1024 ? $"{d.FileSizeBytes / 1024d / 1024:0.0} MB" : $"{Math.Max(1, d.FileSizeBytes / 1024)} KB"))</span>
            </li>
        }
    </ul>
}
