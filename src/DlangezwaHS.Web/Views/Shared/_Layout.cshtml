@using DlangezwaHS.Web.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject DlangezwaHS.Web.Services.NavBadgeService NavBadges
@{
    // Menu items with something new since the user last opened that page
    var newPages = User.Identity?.IsAuthenticated == true
        ? await NavBadges.GetNewPagesAsync(User)
        : new HashSet<string>();
    Microsoft.AspNetCore.Html.IHtmlContent NewDot(params string[] pages)
        => pages.Any(newPages.Contains)
            ? new Microsoft.AspNetCore.Html.HtmlString("<span class=\"nav-new-dot\" title=\"New\"><span class=\"visually-hidden\">(new)</span></span>")
            : Microsoft.AspNetCore.Html.HtmlString.Empty;

    // Highlights the menu section containing the current page ("Controller.Action" or "Controller.*")
    var here = $"{ViewContext.RouteData.Values["controller"]}.{ViewContext.RouteData.Values["action"]}";
    string On(params string[] pages) => pages.Any(p => p.EndsWith(".*")
        ? here.StartsWith(p[..^1], StringComparison.OrdinalIgnoreCase)
        : here.Equals(p, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    var me = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var myName = me is null ? User.Identity?.Name : $"{me.FirstName} {me.LastName}".Trim();
    var myInitials = me is null ? "?" : $"{me.FirstName.FirstOrDefault()}{me.LastName.FirstOrDefault()}".ToUpperInvariant();
    var myId = me?.Id;
    var isHeadChef = myId is not null && User.IsInRole("KitchenStaff")
        && await Db.KitchenTeams.AnyAsync(t => t.IsActive && t.HeadChef != null && t.HeadChef.UserId == myId);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " – " : "")Dlangezwa High School</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="icon" type="image/png" href="~/images/dhs-logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kitchen.css" asp-append-version="true" />
    <style>
        .nav-new-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #38bdf8; box-shadow: 0 0 0 2px rgba(56,189,248,.3); margin-left: .35rem; vertical-align: middle; }
