@model TimetableGridVm
@using DlangezwaHS.Web.Services
@{
    ViewData["Title"] = "Class Timetable";
    var days    = new[] { (1,"Monday"), (2,"Tuesday"), (3,"Wednesday"), (4,"Thursday"), (5,"Friday") };
    var terms   = ViewBag.Terms as string[] ?? Array.Empty<string>();
    var selTerm = (string)(ViewBag.SelectedTerm ?? "Term 1");
    var selYear = (int)(ViewBag.SelectedYear ?? DateTime.UtcNow.Year);
    var slotMap = Model.AllSlots.ToDictionary(s => $"{s.Day}_{s.PeriodNumber}");
}

<style>
    .tt-head th { background: var(--dhs-navy) !important; color: #fff !important; font-weight: 600; font-size: .85rem; border: 0 !important; padding: .7rem .5rem; }
    .tt-grid td { border-color: #eef2f7 !important; transition: transform .2s var(--ease-spring), box-shadow .2s; }
    .tt-grid td[style*="padding:0"] { cursor: default; }
    .tt-grid td[style*="padding:0"]:hover { transform: scale(1.04); box-shadow: 0 10px 20px -10px rgba(11,42,74,.45); position: relative; z-index: 2; border-radius: 8px; }
    @@media (prefers-reduced-motion: reduce) { .tt-grid td { transition: none; } .tt-grid td:hover { transform: none !important; } }
</style>

<div class="page-header k-header d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h2><i class="bi bi-calendar3-week me-2"></i>Class Timetable</h2>
        <p class="mb-0">
            @(Model.SelectedClass?.DisplayName ?? "") — @selTerm @selYear
        </p>
    </div>
    @if (Model.SelectedClass != null && Model.AllSlots.Any())
    {
        <a asp-controller="Timetable" asp-action="DownloadClassPdf"
           asp-route-classId="@Model.SelectedClass.Id"
           asp-route-term="@selTerm" asp-route-year="@selYear"
           class="k-btn k-btn-accent" target="_blank">
            <i class="bi bi-file-earmark-pdf"></i>Download PDF
        </a>
    }
</div>

<!-- Term / Year selector -->
<div class="k-card mb-4 k-rise" style="--i:0">
    <div class="card-body py-2">
        <form method="get" asp-action="LearnerView" class="row g-2 align-items-end">
            <div class="col-sm-3">
                <label class="k-label">Term</label>
                <select name="term" class="form-select k-select" onchange="this.form.submit()">
                    @foreach (var t in terms)
                    { <option value="@t" selected="@(selTerm == t)">@t</option> }
                </select>
            </div>
            <div class="col-sm-2">
                <label class="k-label">Year</label>
                <select name="year" class="form-select k-select" onchange="this.form.submit()">
                    @foreach (var y in Enumerable.Range(DateTime.UtcNow.Year - 1, 3))
                    { <option value="@y" selected="@(selYear == y)">@y</option> }
                </select>
            </div>
        </form>
    </div>
</div>

@if (!Model.AllSlots.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No timetable has been published for @selTerm @selYear yet.
    </div>
}
else
{
    <div class="k-card p-0 overflow-hidden k-rise" style="--i:1">
        <div style="overflow-x:auto;">
            <table class="table table-sm mb-0 align-middle text-center tt-grid" style="min-width:640px;">
                <thead class="tt-head">
                    <tr>
                        <th style="width:110px;">Period</th>
                        @foreach (var (_, dName) in days) { <th>@dName</th> }
                    </tr>
                </thead>
                <tbody>
                    <!-- Assembly -->
                    <tr style="background:#e8f0fe;">
                        <td class="text-start ps-2" style="font-size:.75rem; color:#1a56db; font-weight:600;">
                            <i class="bi bi-megaphone me-1"></i>08:30–09:00
                        </td>
                        @foreach (var (d, _) in days)
                        {
                            <td style="font-size:.75rem; color:#1a56db; font-weight:600;">
                                @if (d == 1 || d == 5) { <span><i class="bi bi-megaphone-fill me-1"></i>Assembly</span> }
                            </td>
                        }
                    </tr>

                    @foreach (var period in SchoolDay.Periods)
                    {
                        var breakBefore = SchoolDay.Breaks.FirstOrDefault(b => b.AfterPeriod == period.Number - 1);
                        @if (breakBefore != null)
                        {
                            <tr style="background:#fef9e7;">
                                <td colspan="6" class="text-center"
                                    style="font-size:.73rem; color:#b7791f; font-weight:600; padding:.3rem;">
                                    <i class="bi bi-cup-hot-fill me-1"></i>
                                    @breakBefore.Label — @breakBefore.Start–@breakBefore.End (15 min)
                                </td>
                            </tr>
                        }
                        <tr>
                            <td class="text-start ps-2">
                                <div class="fw-semibold" style="font-size:.8rem;">@period.Label</div>
                                <div class="text-muted" style="font-size:.7rem;">@period.Start – @period.End</div>
                            </td>
                            @foreach (var (d, _) in days)
                            {
                                var key       = $"{d}_{period.Number}";
                                var available = SchoolDay.IsPeriodAvailable(period.Number, d);
                                @if (!available)
                                {
                                    <td style="background:#f8fafc; color:#94a3b8;">—</td>
                                }
                                else if (slotMap.TryGetValue(key, out var slot))
                                {
                                    var color     = Model.SubjectColors.TryGetValue(slot.SubjectId, out var c) ? c : "#5ea8d3";
                                    var textColor = IsColorDark(color) ? "#fff" : "#000";
                                    <td style="background:@color; padding:0;">
                                        <div style="padding:.4rem .5rem; color:@textColor;">
                                            <div class="fw-bold" style="font-size:.82rem;">@slot.Subject?.Name</div>
                                            <div style="font-size:.7rem; opacity:.85;">
                                                <i class="bi bi-person me-1"></i>@slot.Teacher?.FullName
                                            </div>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td style="background:#f8fafc;"></td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Subject legend -->
    <div class="d-flex gap-2 mt-3 flex-wrap">
        @foreach (var slot in Model.AllSlots.GroupBy(s => s.SubjectId).Select(g => g.First()))
        {
            var color = Model.SubjectColors.TryGetValue(slot.SubjectId, out var c) ? c : "#5ea8d3";
            <span class="badge rounded-pill px-3 py-2" style="background:@color; color:@(IsColorDark(color)?"#fff":"#000"); font-size:.78rem;">
                @slot.Subject?.Name
            </span>
        }
    </div>
}

@functions {
    bool IsColorDark(string hex) {
        if (hex.Length < 7) return false;
        int r = Convert.ToInt32(hex.Substring(1,2),16);
        int g = Convert.ToInt32(hex.Substring(3,2),16);
        int b = Convert.ToInt32(hex.Substring(5,2),16);
        return (r*299 + g*587 + b*114)/1000 < 128;
    }
}
